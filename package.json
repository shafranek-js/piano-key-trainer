{
  "name": "piano-key-trainer",
  "private": true,
  "version": "6.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:runtime-integrity": "node scripts/smokeRuntimeIntegrity.mjs",
    "package:runtime-integrity": "node scripts/buildRuntimeIntegrityArchive.mjs",
    "smoke:scheduler-integrity": "node scripts/smokeSchedulerIntegrity.mjs",
    "package:scheduler-integrity": "node scripts/buildSchedulerIntegrityArchive.mjs",
    "smoke:m3i": "node scripts/smokeM3i.mjs",
    "package:m3i-final": "node scripts/buildM3iFinalArchive.mjs",
    "smoke:m3j": "node scripts/smokeM3j.mjs",
    "package:m3j": "node scripts/buildM3jArchive.mjs",
    "verify": "npm run typecheck && npm run check:svelte && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "dexie": "^4.0.11",
    "jszip": "^3.10.1",
    "opensheetmusicdisplay": "^2.1.3",
    "svelte": "^5.20.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "fake-indexeddb": "^6.2.5",
    "svelte-check": "^4.7.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.5"
  }
}
